# Copy to .env (git-ignored).
SERVICE_ADMIN_PASSWORD=

SERVICE_PORT=29324

# Compose-only: shared AI cache path on the host; never delete its contents.
# SERVICE_MODELS_DIR=../../.cache/huggingface
SERVICE_REPLICAS=1
SERVICE_MEM_LIMIT=0

# Bounded active + waiting requests per replica; 0 = 4.
SERVICE_MAX_INFLIGHT=0

# Local run only; settings also available on admin page.
# SERVICE_HOST=127.0.0.1
# SERVICE_DEVICE=cuda:0
# SERVICE_MODEL_REVISION=main
# SERVICE_NUM_THREAD=6
